# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS for the ingestion worker. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret guarding /api/contracts/[id]/process. Generate with: openssl rand -hex 32
INTERNAL_PROCESSING_SECRET=replace-with-32-byte-hex

# Base URL the upload route uses to invoke the process route. Localhost in dev,
# your deployed origin in prod (e.g. https://clauseium.example.com).
INTERNAL_BASE_URL=http://localhost:3000

# Origin used for OAuth + email-confirm redirects.
# Defaults to the request's host header if unset; set explicitly in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated allow-list of origins permitted to call /api/* with Bearer
# auth (used by the Word add-in). Leave blank in dev unless you're testing the
# add-in locally. Example: https://addin.clauseium.app,https://localhost:3001
ADDIN_ORIGIN=https://localhost:3001
ANTHROPIC_API_KEY=Your-key

# OpenAI — used by the legal-corpus RAG pipeline (text-embedding-3-small).
OPENAI_API_KEY=your-openai-key

# Indian Kanoon — external authoritative source for citation verification.
# When unset, the pipeline degrades to local-corpus-only checks and caps
# verified citations at "partially_verified".
INDIAN_KANOON_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Risk-analysis cost controls
# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION DEFAULTS (used when unset — no need to set these for full quality):
#   RISK_MODEL_DEFAULT=claude-sonnet-4-6        # cheaper model, most clauses
#   RISK_MODEL_ESCALATION=claude-opus-4-8       # strongest model, risky clauses
#   RISK_MAX_LLM_CALLS=100                       # per-contract LLM call cap (risk)
#   CLASSIFICATION_MAX_LLM_CALLS=100             # per-contract LLM call cap (classify)
#   RISK_CASCADE=1                               # cheap-first, escalate-if-risky
#   RISK_CASCADE_ESCALATE_CONFIDENCE=0.75        # escalate below this confidence
#
# Leave the above UNSET for production-grade analysis. The cascade already spends
# the strong model only where risk is real, so it cuts cost without lowering
# quality.
#
# CHEAP TESTING PROFILE — for plumbing/E2E runs ONLY (e.g. verifying the Word
# export). This DEGRADES analysis quality; never use it for real review. It runs
# the whole pipeline on cheap models with a low call cap, so a test upload costs
# cents instead of dollars:
#   RISK_MODEL_DEFAULT=claude-haiku-4-5-20251001
#   RISK_MODEL_ESCALATION=claude-sonnet-4-6
#   RISK_MAX_LLM_CALLS=20
#   CLASSIFICATION_MAX_LLM_CALLS=20