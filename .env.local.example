# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS for the ingestion worker. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret guarding /api/contracts/[id]/process. Generate with: openssl rand -hex 32
INTERNAL_PROCESSING_SECRET=replace-with-32-byte-hex

# Base URL the upload route uses to invoke the process route. Localhost in dev,
# your deployed origin in prod (e.g. https://clauseium.example.com).
INTERNAL_BASE_URL=http://localhost:3000

# Origin used for OAuth + email-confirm redirects.
# Defaults to the request's host header if unset; set explicitly in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated allow-list of origins permitted to call /api/* with Bearer
# auth (used by the Word add-in). Leave blank in dev unless you're testing the
# add-in locally. Example: https://addin.clauseium.app,https://localhost:3001
ADDIN_ORIGIN=https://localhost:3001
ANTHROPIC_API_KEY=Your-key

# OpenAI — used by the legal-corpus RAG pipeline (text-embedding-3-small).
OPENAI_API_KEY=your-openai-key

# Indian Kanoon — external authoritative source for citation verification.
# When unset, the pipeline degrades to local-corpus-only checks and caps
# verified citations at "partially_verified".
INDIAN_KANOON_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Risk-analysis cost controls
# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION DEFAULTS (used when unset — no need to set these for full quality):
#   RISK_MODEL_DEFAULT=claude-sonnet-4-6        # cheaper model, most clauses
#   RISK_MODEL_ESCALATION=claude-opus-4-8       # strongest model, risky clauses
#   RISK_MAX_LLM_CALLS=100                       # per-contract LLM call cap (risk)
#   CLASSIFICATION_MAX_LLM_CALLS=100             # per-contract LLM call cap (classify)
#   RISK_CASCADE=1                               # cheap-first, escalate-if-risky
#   RISK_CASCADE_ESCALATE_CONFIDENCE=0.75        # escalate below this confidence
#   DOC_ANALYSIS_MODEL=claude-sonnet-4-6         # whole-document pass model
#       (defaults to the cheaper RISK_MODEL_DEFAULT; it was the priciest single
#        call per contract. Set to claude-opus-4-8 to restore max document-level
#        depth — the per-clause analysis still escalates to the strong model.)
#   DOC_ANALYSIS_GATE=0                           # 1 = skip the LLM whole-document
#       pass for a contract that is BOTH short AND clean (returns the deterministic
#       playbook checklist instead). Only skips when there are fewer than
#       DOC_ANALYSIS_MIN_CLAUSES clauses, NO clause is high/missing, and the
#       playbook finds no high-importance gap — so recall on complex/risky docs is
#       preserved. OFF by default.
#   DOC_ANALYSIS_MIN_CLAUSES=8                    # gate threshold (clause count)
#   RISK_CACHE=1                                 # cross-contract clause-analysis
#       cache (default ON; set 0 to disable). Reuses a prior analysis of the
#       identical clause text+category — quality-neutral. Needs migration 0012;
#       migration-tolerant (no table → simply doesn't cache).
#   RISK_SEMDEDUP=0                              # 1 = also collapse near-DUPLICATE
#       clauses (not just verbatim) so each is analyzed once. Conservative: only
#       merges clauses with >= RISK_SEMDEDUP_THRESHOLD cosine similarity AND the
#       same category AND an identical rule signature. Uses OpenAI embeddings;
#       degrades to exact-dedup-only if unavailable. OFF by default — turn on only
#       after a scored eval confirms no regression.
#   RISK_SEMDEDUP_THRESHOLD=0.97                  # cosine-similarity merge floor
#   RISK_LOWSTAKES_HAIKU=0                        # 1 = route confident, rule-clean
#       'other'-category clauses (the catch-all, no specialised rules) to the cheap
#       model first. The cascade still gives any risky/uncertain Haiku pass a
#       Sonnet re-read, so recall is preserved. OFF by default — turn on only after
#       a scored eval confirms no regression. High-stakes categories are untouched.
#   RISK_MODEL_CHEAP=claude-haiku-4-5-20251001   # the cheap tier used above
#
# Batch API (DEFAULT-ON). Routes ELIGIBLE per-clause risk calls through Anthropic
# Message Batches — same model/prompt/output, ~50% cheaper, but slower (results
# arrive in minutes). Safe by construction: only clauses that would run a single
# pass on the same model in real-time too are batched, so it never defeats the
# cheap→escalate cascade on high-stakes clauses; small uploads stay real-time via
# the min-clause gate; anything the batch can't deliver falls back to real-time.
#   RISK_BATCH_DEFAULT=1                          # default-on; 0/off to disable
#   RISK_USE_BATCH=                              # explicit 0/1 OVERRIDES the default
#   RISK_BATCH_MIN_CLAUSES=12                     # below this many batch-safe clauses,
#                                                #   stay real-time (keeps small/
#                                                #   interactive uploads fast)
#   RISK_BATCH_MAX_WAIT_MS=180000                # max wait before real-time fallback
#                                                #   (kept under the 240s stale window)
#
# Cost observability (OPT-IN, default OFF). Logs per-call metadata — model,
# category, path (realtime/cascade_cheap/cascade_escalate/batch/doc/cache_hit),
# token counts, cache hits — to the llm_call_log table so spend is measurable per
# contract. Stores NO clause text (DPDP-safe). Needs migration 0013; fully
# migration-tolerant (no table → silently skips) and fire-and-forget (never
# blocks or fails analysis).
#   RISK_COST_LOG=0                              # 1 = record per-call cost rows
#
# Inline citation guard (DEFAULT-ON). Detects statute references written in PROSE
# (not bracketed as [CITE: …]) and pushes them through the same verify→gate path:
# verified ones surface as authorities; ungrounded ones are NEUTRALISED in the
# displayed text ("applicable Indian law"). Enforces the CLAUDE.md "every citation
# verified before display" mandate beyond bracketed tokens. Needs the supported
# statutes ingested (npm run ingest:legal) so legitimate refs verify.
#   INLINE_GUARD_ENABLED=1                        # 0 to disable
#   INLINE_GUARD_MODE=neutralize                 # 'neutralize' (strip ungrounded
#                                                #   refs) or 'chip' (keep + warn)
#
# Leave the above UNSET for production-grade analysis. The cascade already spends
# the strong model only where risk is real, so it cuts cost without lowering
# quality.
#
# CHEAP TESTING PROFILE — for plumbing/E2E runs ONLY (e.g. verifying the Word
# export). This DEGRADES analysis quality; never use it for real review. It runs
# the whole pipeline on cheap models with a low call cap, so a test upload costs
# cents instead of dollars:
#   RISK_MODEL_DEFAULT=claude-haiku-4-5-20251001
#   RISK_MODEL_ESCALATION=claude-sonnet-4-6
#   RISK_MAX_LLM_CALLS=20
#   CLASSIFICATION_MAX_LLM_CALLS=20