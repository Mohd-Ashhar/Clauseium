<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Clauseium Word Add-in - manifest template.

  This file is the source of truth for all three environment manifests
  (dev / staging / prod). Concrete manifests are generated by:
    node scripts/build-manifest.mjs --env=dev|staging|prod

  The generator does a literal text substitution on the double-curly
  placeholders below (MANIFEST_GUID, DISPLAY_NAME, ADDIN_ORIGIN, APP_ORIGIN).
  The generated files (manifest.dev.xml, manifest.staging.xml,
  manifest.prod.xml) are git-ignored — only this template is committed.

  Why three GUIDs: each environment needs a distinct add-in identity so all
  three can be sideloaded into the same Word install simultaneously without
  Office's add-in catalog treating them as the same app.

  AppDomains MUST list every origin the task pane navigates to (Supabase
  OAuth, the main Clauseium app, etc.). Missing entries silently break the
  Dialog API navigation.

  Note: XML comments cannot contain a double-hyphen sequence anywhere
  inside them (per the XML spec). Avoid double-hyphens in this file.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>{{MANIFEST_GUID}}</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Clauseium</ProviderName>
  <DefaultLocale>en-IN</DefaultLocale>
  <DisplayName DefaultValue="{{DISPLAY_NAME}}" />
  <Description DefaultValue="AI contract review for Indian counsel." />
  <IconUrl DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-128.png" />
  <SupportUrl DefaultValue="{{APP_ORIGIN}}/support" />

  <AppDomains>
    <AppDomain>{{APP_ORIGIN}}</AppDomain>
    <AppDomain>{{ADDIN_ORIGIN}}</AppDomain>
    <AppDomain>https://supabase.co</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://accounts.google.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.4" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="{{ADDIN_ORIGIN}}/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Clauseium.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="Clauseium.OpenTaskpane">
                  <Label resid="OpenTaskpane.Label" />
                  <Supertip>
                    <Title resid="OpenTaskpane.Title" />
                    <Description resid="OpenTaskpane.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Clauseium.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="{{ADDIN_ORIGIN}}/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="{{APP_ORIGIN}}" />
        <bt:Url id="Taskpane.Url" DefaultValue="{{ADDIN_ORIGIN}}/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Review with Clauseium" />
        <bt:String id="Group.Label" DefaultValue="Clauseium" />
        <bt:String id="OpenTaskpane.Label" DefaultValue="Review" />
        <bt:String id="OpenTaskpane.Title" DefaultValue="Review with Clauseium" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open the Clauseium task pane to review the current document." />
        <bt:String id="OpenTaskpane.Tooltip" DefaultValue="Open the Clauseium review pane to analyze the current document." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
